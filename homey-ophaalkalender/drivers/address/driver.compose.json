{
  "name": {
    "en": "Address",
    "nl": "Adres"
  },
  "class": "other",
  "capabilities": [
    "pickup_next",
    "pickup_white",
    "pickup_yellow",
    "pickup_blue",
    "pickup_green",
    "pickup_orange"
  ],
  "platforms": [
    "local"
  ],
  "connectivity": [
    "cloud"
  ],
  "images": {
    "small": "{{driverAssetsPath}}/images/small.png",
    "large": "{{driverAssetsPath}}/images/large.png",
    "xlarge": "{{driverAssetsPath}}/images/xlarge.png"
  },
  "pair": [
    {
      "id": "address",
      "navigation": {
        "next": "list_devices"
      }
    },
    {
      "id": "list_devices",
      "template": "list_devices",
      "navigation": {
        "next": "add_devices"
      }
    },
    {
      "id": "add_devices",
      "template": "add_devices"
    }
  ],
  "settings": [
    {
      "type": "group",
      "label": {
        "en": "Notifications",
        "nl": "Notificaties"
      },
      "children": [
        {
          "id": "notify_window_open",
          "type": "checkbox",
          "value": true,
          "label": {
            "en": "Notify when putting out is allowed (start of the time window)",
            "nl": "Melding zodra buitenzetten mag (begin van het uur-venster)"
          }
        },
        {
          "id": "notify_same_day",
          "type": "checkbox",
          "label": {
            "en": "Notify on the day itself",
            "nl": "Melding op de dag zelf"
          },
          "value": false
        },
        {
          "id": "notify_same_day_time",
          "type": "text",
          "label": {
            "en": "Time (HH:MM)",
            "nl": "Tijdstip (UU:MM)"
          },
          "value": "17:00",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
        },
        {
          "id": "notify_evening_before",
          "type": "checkbox",
          "label": {
            "en": "Notify the evening before",
            "nl": "Melding de avond ervoor"
          },
          "value": false
        },
        {
          "id": "notify_evening_before_time",
          "type": "text",
          "label": {
            "en": "Time (HH:MM)",
            "nl": "Tijdstip (UU:MM)"
          },
          "value": "20:00",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
        }
      ]
    },
    {
      "type": "group",
      "label": {
        "en": "Which bags",
        "nl": "Welke zakken"
      },
      "children": [
        {
          "id": "notify_white",
          "type": "checkbox",
          "label": {
            "en": "White bag",
            "nl": "Witte zak"
          },
          "value": true
        },
        {
          "id": "notify_yellow",
          "type": "checkbox",
          "label": {
            "en": "Yellow bag",
            "nl": "Gele zak"
          },
          "value": true
        },
        {
          "id": "notify_blue",
          "type": "checkbox",
          "label": {
            "en": "Blue bag",
            "nl": "Blauwe zak"
          },
          "value": true
        },
        {
          "id": "notify_green",
          "type": "checkbox",
          "label": {
            "en": "Green bag",
            "nl": "Groene zak"
          },
          "value": true
        },
        {
          "id": "notify_orange",
          "type": "checkbox",
          "label": {
            "en": "Orange bag",
            "nl": "Oranje zak"
          },
          "value": true
        }
      ]
    },
    {
      "type": "group",
      "label": {
        "en": "Calendar",
        "nl": "Kalender"
      },
      "children": [
        {
          "id": "address",
          "type": "label",
          "label": {
            "en": "Address",
            "nl": "Adres"
          },
          "value": "-"
        },
        {
          "id": "last_update",
          "type": "label",
          "label": {
            "en": "Last updated",
            "nl": "Laatst bijgewerkt"
          },
          "value": "-"
        },
        {
          "id": "source",
          "type": "label",
          "value": "-",
          "label": {
            "en": "Data source",
            "nl": "Gegevensbron"
          }
        }
      ]
    }
  ]
}
