# --- Algemeen
DB_PATH=data/wijnlog.db
BACKUP_DIR=data/backups
# optioneel: na elke back-up kopiëren naar externe opslag, bv. "rclone copy {file} gdrive:wijnlog"
BACKUP_UPLOAD_CMD=

# --- Vivino (sync). Wachtwoord of cookie; cookie is het vangnet als login faalt.
VIVINO_EMAIL=
VIVINO_PASSWORD=
VIVINO_COOKIE=
COUNTRY_CODE=BE
# bescherming tegen te vaak pollen
SYNC_MIN_INTERVAL_HOURS=6

# --- Scorebron: volgorde van fallbacks, komma-gescheiden: vivino,apify,rapidapi
SCORE_SOURCES=vivino,apify
APIFY_TOKEN=
APIFY_ACTOR=
# JSON-body voor de actor; {query} wordt vervangen
APIFY_INPUT={"search": "{query}", "maxItems": 5}
RAPIDAPI_KEY=
RAPIDAPI_HOST=
RAPIDAPI_PATH=/search
RAPIDAPI_QUERY_PARAM=q

# --- WhatsApp Cloud API (Meta)
WA_VERIFY_TOKEN=kies-een-lang-random-token
WA_APP_SECRET=
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
# jouw nummer(s) zonder +, komma-gescheiden. Alles van andere nummers wordt genegeerd.
WA_ALLOWED_NUMBERS=32470000000
WA_GRAPH_VERSION=v21.0

# --- Vision voor labelfoto's (optioneel; leeg = foto's uitgeschakeld)
ANTHROPIC_API_KEY=
VISION_MODEL=claude-sonnet-5-5
